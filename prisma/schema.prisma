generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id            String   @id @default(cuid())
  fullName      String
  title         String?
  company       String
  domain        String?
  industry      String?
  employeeCount Int?
  email         String?
  linkedinUrl   String?
  location      String?

  score         Int      @default(0)
  tier          String   @default("cold")
  scoreBreakdown String  @default("{}")
  isDuplicate   Boolean  @default(false)
  duplicateOfId String?
  enrichedAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([score])
  @@index([domain])
}